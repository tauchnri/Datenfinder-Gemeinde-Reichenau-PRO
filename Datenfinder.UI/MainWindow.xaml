<Window x:Class="Datenfinder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datenfinder Gemeinde Reichenau PRO"
        Height="900"
        Width="1450"
        MinHeight="760"
        MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- =====================================================
             KOPF
             ===================================================== -->

        <Border Grid.Row="0"
                Background="#123B63">

            <Grid Margin="26,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Datenfinder Gemeinde Reichenau PRO"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Alles finden. Sofort."
                               Foreground="#D9E7F3"
                               FontSize="12"
                               Margin="1,2,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- =====================================================
             HAUPTBEREICH
             ===================================================== -->

        <Grid Grid.Row="1"
              Margin="24,12,24,10">

            <Grid.RowDefinitions>

                <!-- System -->
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="8"/>

                <!-- Filter -->
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="8"/>

                <!-- Suche -->
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="7"/>

                <!-- Fortschritt -->
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="6"/>

                <!-- Ergebnisleiste -->
                <RowDefinition Height="Auto"/>

                <!-- Ergebnisse -->
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- =================================================
                 OUTLOOK + SUCHINDEX
                 ================================================= -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="12"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- Outlook -->

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="7"
                        BorderBrush="#D7DCE1"
                        BorderThickness="1"
                        Padding="12">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="155"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="1. Outlook 365"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#123B63"/>

                            <TextBlock x:Name="OutlookStatusText"
                                       Text="Status: noch nicht geprüft"
                                       FontSize="12"
                                       Foreground="#555555"
                                       TextWrapping="Wrap"
                                       Margin="0,4,10,0"/>

                            <TextBlock x:Name="OutlookDetailsText"
                                       Text=""
                                       FontSize="11"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       Margin="0,2,10,0"/>

                            <TextBlock x:Name="MailboxNamesText"
                                       Text=""
                                       FontSize="9"
                                       Foreground="#888888"
                                       TextWrapping="Wrap"
                                       Margin="0,3,10,0"/>

                        </StackPanel>

                        <Button x:Name="ConnectOutlookButton"
                                Grid.Column="1"
                                Content="Outlook prüfen"
                                Height="34"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Click="ConnectOutlookButton_Click"/>

                    </Grid>

                </Border>

                <!-- Suchindex -->

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="7"
                        BorderBrush="#D7DCE1"
                        BorderThickness="1"
                        Padding="12">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="155"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="2. Suchindex"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#123B63"/>

                            <TextBlock x:Name="IndexStatusText"
                                       Text="Suchindex noch nicht erstellt"
                                       FontSize="12"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       Margin="0,4,10,0"/>

                            <TextBlock x:Name="IndexDetailsText"
                                       Text="Nach Programmstart Outlook prüfen und den Index bei Bedarf aktualisieren."
                                       FontSize="11"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       Margin="0,2,10,0"/>

                            <TextBlock x:Name="LastUpdateText"
                                       Text=""
                                       FontSize="9"
                                       Foreground="#888888"
                                       Margin="0,3,10,0"/>

                        </StackPanel>

                        <Button x:Name="CreateIndexButton"
                                Grid.Column="1"
                                Content="Jetzt aktualisieren"
                                Height="34"
                                VerticalAlignment="Center"
                                FontSize="13"
                                IsEnabled="False"
                                Click="CreateIndexButton_Click"/>

                    </Grid>

                </Border>

            </Grid>

            <!-- =================================================
                 FILTER
                 ================================================= -->

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="7"
                    BorderBrush="#D7DCE1"
                    BorderThickness="1"
                    Padding="10">

                <StackPanel>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="125"/>

                            <ColumnDefinition Width="125"/>

                            <ColumnDefinition Width="170"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="145"/>

                            <ColumnDefinition Width="160"/>

                            <ColumnDefinition Width="150"/>

                        </Grid.ColumnDefinitions>

                        <!-- Von -->

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,8,0">

                            <TextBlock Text="Von"
                                       FontSize="10"
                                       Foreground="#555555"
                                       Margin="1,0,0,2"/>

                            <DatePicker x:Name="FromDatePicker"
                                        Height="29"/>

                        </StackPanel>

                        <!-- Bis -->

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,8,0">

                            <TextBlock Text="Bis"
                                       FontSize="10"
                                       Foreground="#555555"
                                       Margin="1,0,0,2"/>

                            <DatePicker x:Name="ToDatePicker"
                                        Height="29"/>

                        </StackPanel>

                        <!-- Postfach -->

                        <StackPanel Grid.Column="2"
                                    Margin="0,0,8,0">

                            <TextBlock Text="Postfach"
                                       FontSize="10"
                                       Foreground="#555555"
                                       Margin="1,0,0,2"/>

                            <ComboBox x:Name="MailboxComboBox"
                                      Height="29"/>

                        </StackPanel>

                        <!-- Absender -->

                        <StackPanel Grid.Column="3"
                                    Margin="0,0,8,0">

                            <TextBlock Text="Absender enthält"
                                       FontSize="10"
                                       Foreground="#555555"
                                       Margin="1,0,0,2"/>

                            <TextBox x:Name="SenderFilterTextBox"
                                     Height="29"
                                     Padding="6,3"
                                     VerticalContentAlignment="Center"/>

                        </StackPanel>

                        <!-- Empfänger -->

                        <StackPanel Grid.Column="4"
                                    Margin="0,0,8,0">

                            <TextBlock Text="Empfänger enthält"
                                       FontSize="10"
                                       Foreground="#555555"
                                       Margin="1,0,0,2"/>

                            <TextBox x:Name="RecipientFilterTextBox"
                                     Height="29"
                                     Padding="6,3"
                                     VerticalContentAlignment="Center"/>

                        </StackPanel>

                        <!-- Anhang -->

                        <StackPanel Grid.Column="5"
                                    Margin="0,0,8,0">

                            <TextBlock Text="Anhang"
                                       FontSize="10"
                                       Foreground="#555555"
                                       Margin="1,0,0,2"/>

                            <ComboBox x:Name="AttachmentComboBox"
                                      Height="29">

                                <ComboBoxItem Content="Alle"/>

                                <ComboBoxItem Content="Mit Anhang"/>

                                <ComboBoxItem Content="Ohne Anhang"/>

                            </ComboBox>

                        </StackPanel>

                        <!-- Kennzeichnung -->

                        <StackPanel Grid.Column="6"
                                    Margin="0,0,8,0">

                            <TextBlock Text="Kennzeichnung"
                                       FontSize="10"
                                       Foreground="#555555"
                                       Margin="1,0,0,2"/>

                            <ComboBox x:Name="FlagComboBox"
                                      Height="29">

                                <ComboBoxItem Content="Alle"/>

                                <ComboBoxItem Content="Gekennzeichnet"/>

                                <ComboBoxItem Content="Nicht gekennzeichnet"/>

                                <ComboBoxItem Content="Erledigt / Häkchen"/>

                                <ComboBoxItem Content="Fähnchen"/>

                            </ComboBox>

                        </StackPanel>

                        <!-- Sortierung -->

                        <StackPanel Grid.Column="7">

                            <TextBlock Text="Sortierung"
                                       FontSize="10"
                                       Foreground="#555555"
                                       Margin="1,0,0,2"/>

                            <ComboBox x:Name="SortComboBox"
                                      Height="29">

                                <ComboBoxItem Content="Neueste zuerst"/>

                                <ComboBoxItem Content="Älteste zuerst"/>

                            </ComboBox>

                        </StackPanel>

                    </Grid>

                    <Grid Margin="0,6,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="140"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="150"/>

                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="SubjectOnlyCheckBox"
                                  Grid.Column="0"
                                  Content="Nur Betreff"
                                  VerticalAlignment="Center"
                                  FontSize="11"/>

                        <TextBlock x:Name="ActiveFiltersText"
                                   Grid.Column="1"
                                   Text="Aktive Filter: keine"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="#777777"
                                   TextWrapping="Wrap"/>

                        <Button x:Name="ResetFiltersButton"
                                Grid.Column="2"
                                Content="Filter zurücksetzen"
                                Height="27"
                                FontSize="11"
                                Click="ResetFiltersButton_Click"/>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- =================================================
                 SUCHE
                 ================================================= -->

            <Border Grid.Row="4"
                    Background="#EAF3FB"
                    CornerRadius="8"
                    BorderBrush="#4F8FC4"
                    BorderThickness="2"
                    Padding="9">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="175"/>

                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             Height="40"
                             FontSize="16"
                             Padding="12,6"
                             VerticalContentAlignment="Center"
                             ToolTip="Suchbegriff eingeben"
                             KeyDown="SearchTextBox_KeyDown"/>

                    <Button x:Name="SearchButton"
                            Grid.Column="1"
                            Content="SUCHEN"
                            Height="40"
                            Margin="10,0,0,0"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#0B5FA5"
                            BorderBrush="#084C84"
                            BorderThickness="1"
                            Cursor="Hand"
                            IsEnabled="False"
                            Click="SearchButton_Click"/>

                </Grid>

            </Border>

            <!-- =================================================
                 FORTSCHRITT
                 ================================================= -->

            <Border Grid.Row="6"
                    x:Name="ProgressPanel"
                    Background="#FFFDF2"
                    CornerRadius="7"
                    BorderBrush="#D8C66A"
                    BorderThickness="1"
                    Padding="9"
                    Visibility="Collapsed">

                <StackPanel>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="80"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ProgressPhaseText"
                                   Text="Vorbereitung ..."
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"/>

                        <TextBlock x:Name="ProgressPercentText"
                                   Grid.Column="1"
                                   Text="0 %"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="#123B63"/>

                    </Grid>

                    <ProgressBar x:Name="IndexProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="20"
                                 Margin="0,6,0,0"
                                 IsIndeterminate="False"/>

                    <Grid Margin="0,4,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ProgressCountText"
                                   Grid.Column="0"
                                   Text=""
                                   FontSize="10"
                                   Foreground="#555555"/>

                        <TextBlock x:Name="ProgressFolderText"
                                   Grid.Column="2"
                                   Text=""
                                   FontSize="10"
                                   Foreground="#777777"
                                   TextTrimming="CharacterEllipsis"/>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- =================================================
                 ERGEBNISLEISTE
                 ================================================= -->

            <Grid Grid.Row="8"
                  Margin="0,0,0,5">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="190"/>

                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="SearchStatusText"
                               Text=""
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="   |   Doppelklick öffnet die Original-Mail."
                               FontSize="10"
                               Foreground="#888888"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <Button x:Name="OpenSelectedMailButton"
                        Grid.Column="1"
                        Content="Original-Mail öffnen"
                        Height="28"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Click="OpenSelectedMailButton_Click"/>

            </Grid>

            <!-- =================================================
                 SUCHERGEBNISSE
                 ================================================= -->

            <DataGrid x:Name="SearchResultsGrid"
                      Grid.Row="9"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="#C9CED3"
                      BorderThickness="1"
                      Background="White"
                      Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="SearchResultsGrid_MouseDoubleClick">

                <!-- =================================================
                     ROLLOVER / TOOLTIP
                     ================================================= -->

                <DataGrid.RowStyle>

                    <Style TargetType="DataGridRow">

                        <Setter Property="Cursor"
                                Value="Hand"/>

                        <Setter Property="ToolTipService.InitialShowDelay"
                                Value="350"/>

                        <Setter Property="ToolTipService.ShowDuration"
                                Value="10000"/>

                        <Setter Property="ToolTip">

                            <Setter.Value>

                                <ToolTip Placement="Mouse">

                                    <StackPanel Margin="4">

                                        <TextBlock Text="Original-Mail öffnen"
                                                   FontWeight="Bold"
                                                   FontSize="13"/>

                                        <TextBlock Text="Doppelklick auf diesen Treffer öffnet die E-Mail direkt in Outlook."
                                                   Margin="0,4,0,0"
                                                   FontSize="11"/>

                                    </StackPanel>

                                </ToolTip>

                            </Setter.Value>

                        </Setter>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#EAF3FB"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </DataGrid.RowStyle>

                <!-- =================================================
                     RECHTSKLICK BLEIBT ZUSÄTZLICH BESTEHEN
                     ================================================= -->

                <DataGrid.ContextMenu>

                    <ContextMenu>

                        <MenuItem Header="Original-Mail jetzt in Outlook öffnen"
                                  FontWeight="SemiBold"
                                  Click="OpenOriginalMailMenuItem_Click"/>

                    </ContextMenu>

                </DataGrid.ContextMenu>

                <!-- =================================================
                     SPALTEN
                     ================================================= -->

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Datum"
                                        Binding="{Binding Date}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Postfach"
                                        Binding="{Binding Mailbox}"
                                        Width="145"/>

                    <DataGridTextColumn Header="Empfänger"
                                        Binding="{Binding Recipient}"
                                        Width="190"/>

                    <DataGridTextColumn Header="Absender"
                                        Binding="{Binding Sender}"
                                        Width="175"/>

                    <DataGridTextColumn Header="Kennzeichnung"
                                        Binding="{Binding Flag}"
                                        Width="135"/>

                    <DataGridTextColumn Header="Anhang"
                                        Binding="{Binding Attachment}"
                                        Width="75"/>

                    <DataGridTextColumn Header="Betreff"
                                        Binding="{Binding Subject}"
                                        Width="2.5*"/>

                    <DataGridTextColumn Header="Ordner"
                                        Binding="{Binding Folder}"
                                        Width="1.7*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

        <!-- =====================================================
             FUSSZEILE
             ===================================================== -->

        <Border Grid.Row="2"
                Background="#E8ECF0">

            <Grid Margin="20,4">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <TextBlock Text="Build 1100 | Datenfinder Gemeinde Reichenau PRO | © 2026"
                           Foreground="#555555"
                           FontSize="10"/>

                <TextBlock Grid.Row="1"
                           Text="Entwickelt von Richard Tauchner in Zusammenarbeit mit OpenAI ChatGPT"
                           Foreground="#7A7A7A"
                           FontSize="8"
                           Margin="0,2,0,0"/>

            </Grid>

        </Border>

    </Grid>

</Window>