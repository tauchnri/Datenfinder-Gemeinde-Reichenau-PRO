<Window x:Class="Datenfinder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datenfinder Gemeinde Reichenau PRO"
        Height="900"
        Width="1400"
        MinHeight="760"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- =====================================================
             KOPFBEREICH
             ===================================================== -->
        <Border Grid.Row="0"
                Background="#123B63">
            <Grid Margin="28,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Datenfinder Gemeinde Reichenau PRO"
                               Foreground="White"
                               FontSize="27"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Alles finden. Sofort."
                               Foreground="#D9E7F3"
                               FontSize="14"
                               Margin="1,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =====================================================
             HAUPTBEREICH
             ===================================================== -->
        <Grid Grid.Row="1"
              Margin="28,16,28,14">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- =================================================
                 1. SYSTEMBEREITSCHAFT
                 ================================================= -->
            <StackPanel Grid.Row="0">

                <TextBlock Text="1. Systembereitschaft prüfen"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#123B63"/>

                <TextBlock Text="Nach dem Programmstart zuerst Outlook prüfen. Anschließend den Suchindex bei Bedarf aktualisieren."
                           FontSize="12"
                           Foreground="#666666"
                           Margin="0,3,0,7"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Outlook 365 -->
                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="8"
                            BorderBrush="#D7DCE1"
                            BorderThickness="1"
                            Padding="15">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="165"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Outlook 365"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="OutlookStatusText"
                                           Text="Status: noch nicht geprüft"
                                           FontSize="13"
                                           Foreground="#555555"
                                           TextWrapping="Wrap"
                                           Margin="0,6,12,0"/>

                                <TextBlock x:Name="OutlookDetailsText"
                                           Text=""
                                           FontSize="12"
                                           Foreground="#777777"
                                           TextWrapping="Wrap"
                                           Margin="0,3,12,0"/>

                                <TextBlock x:Name="MailboxNamesText"
                                           Text=""
                                           FontSize="10"
                                           Foreground="#888888"
                                           TextWrapping="Wrap"
                                           Margin="0,4,12,0"/>
                            </StackPanel>

                            <Button x:Name="ConnectOutlookButton"
                                    Grid.Column="1"
                                    Content="Outlook prüfen"
                                    Height="38"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Click="ConnectOutlookButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Suchindex -->
                    <Border Grid.Column="2"
                            Background="White"
                            CornerRadius="8"
                            BorderBrush="#D7DCE1"
                            BorderThickness="1"
                            Padding="15">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="165"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Suchindex"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="IndexStatusText"
                                           Text="Suchindex noch nicht erstellt"
                                           FontSize="13"
                                           Foreground="#777777"
                                           TextWrapping="Wrap"
                                           Margin="0,6,12,0"/>

                                <TextBlock x:Name="IndexDetailsText"
                                           Text="Klicken Sie zuerst auf „Outlook prüfen“."
                                           FontSize="12"
                                           Foreground="#777777"
                                           TextWrapping="Wrap"
                                           Margin="0,3,12,0"/>

                                <TextBlock x:Name="LastUpdateText"
                                           Text=""
                                           FontSize="10"
                                           Foreground="#888888"
                                           TextWrapping="Wrap"
                                           Margin="0,4,12,0"/>

                                <TextBlock Text="Automatische Aktualisierung: alle 60 Minuten, solange der Datenfinder läuft."
                                           FontSize="10"
                                           Foreground="#888888"
                                           TextWrapping="Wrap"
                                           Margin="0,2,12,0"/>
                            </StackPanel>

                            <Button x:Name="CreateIndexButton"
                                    Grid.Column="1"
                                    Content="Jetzt aktualisieren"
                                    Height="38"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    IsEnabled="False"
                                    Click="CreateIndexButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- =================================================
                 FORTSCHRITTSANZEIGE
                 ================================================= -->
            <Border Grid.Row="2"
                    x:Name="ProgressPanel"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#D7DCE1"
                    BorderThickness="1"
                    Padding="10"
                    Visibility="Collapsed">

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ProgressPhaseText"
                                   Text="Vorbereitung ..."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="ProgressPercentText"
                                   Grid.Column="1"
                                   Text=""
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="15,0,0,0"/>
                    </Grid>

                    <ProgressBar x:Name="IndexProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="16"
                                 Margin="0,7,0,0"/>

                    <TextBlock x:Name="ProgressCountText"
                               Text=""
                               FontSize="11"
                               Foreground="#555555"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>

                    <TextBlock x:Name="ProgressFolderText"
                               Text=""
                               FontSize="11"
                               Foreground="#777777"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- =================================================
                 2. SUCHE
                 ================================================= -->
            <Border Grid.Row="4"
                    Background="#EAF3FB"
                    CornerRadius="9"
                    BorderBrush="#5B9BD5"
                    BorderThickness="2"
                    Padding="14">

                <StackPanel>

                    <TextBlock Text="2. E-Mails durchsuchen"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#123B63"
                               Margin="0,0,0,7"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="0"
                                 Height="46"
                                 FontSize="17"
                                 Padding="14,8"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Suchbegriff eingeben"
                                 KeyDown="SearchTextBox_KeyDown"/>

                        <Button x:Name="SearchButton"
                                Grid.Column="1"
                                Content="Suchen"
                                Height="46"
                                Margin="12,0,0,0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                IsEnabled="False"
                                Click="SearchButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- =================================================
                 3. SUCHFILTER
                 ================================================= -->
            <Border Grid.Row="6"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#D7DCE1"
                    BorderThickness="1"
                    Padding="12">

                <StackPanel>

                    <TextBlock Text="3. Suche eingrenzen"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#123B63"
                               Margin="0,0,0,8"/>

                    <!-- Filterzeile 1 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">

                            <TextBlock Text="Zeitraum von"
                                       FontSize="11"
                                       Foreground="#555555"
                                       Margin="1,0,0,3"/>

                            <DatePicker x:Name="FromDatePicker"
                                        Height="31"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,10,0">

                            <TextBlock Text="bis"
                                       FontSize="11"
                                       Foreground="#555555"
                                       Margin="1,0,0,3"/>

                            <DatePicker x:Name="ToDatePicker"
                                        Height="31"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Margin="0,0,10,0">

                            <TextBlock Text="Postfach"
                                       FontSize="11"
                                       Foreground="#555555"
                                       Margin="1,0,0,3"/>

                            <ComboBox x:Name="MailboxComboBox"
                                      Height="31"/>
                        </StackPanel>

                        <!-- NEU: Absender -->
                        <StackPanel Grid.Column="3"
                                    Margin="0,0,10,0">

                            <TextBlock Text="Absender enthält"
                                       FontSize="11"
                                       Foreground="#555555"
                                       Margin="1,0,0,3"/>

                            <TextBox x:Name="SenderFilterTextBox"
                                     Height="31"
                                     Padding="7,4"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Name oder Teil einer Absenderadresse eingeben"/>
                        </StackPanel>

                        <!-- NEU: Empfänger -->
                        <StackPanel Grid.Column="4">

                            <TextBlock Text="Empfänger enthält"
                                       FontSize="11"
                                       Foreground="#555555"
                                       Margin="1,0,0,3"/>

                            <TextBox x:Name="RecipientFilterTextBox"
                                     Height="31"
                                     Padding="7,4"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Name oder Teil eines Empfängers eingeben"/>
                        </StackPanel>
                    </Grid>

                    <!-- Filterzeile 2 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">

                            <TextBlock Text="Anhang"
                                       FontSize="11"
                                       Foreground="#555555"
                                       Margin="1,0,0,3"/>

                            <ComboBox x:Name="AttachmentComboBox"
                                      Height="31">
                                <ComboBoxItem Content="Alle"/>
                                <ComboBoxItem Content="Mit Anhang"/>
                                <ComboBoxItem Content="Ohne Anhang"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,10,0">

                            <TextBlock Text="Kennzeichnung"
                                       FontSize="11"
                                       Foreground="#555555"
                                       Margin="1,0,0,3"/>

                            <ComboBox x:Name="FlagComboBox"
                                      Height="31">
                                <ComboBoxItem Content="Alle"/>
                                <ComboBoxItem Content="Gekennzeichnet"/>
                                <ComboBoxItem Content="Nicht gekennzeichnet"/>
                                <ComboBoxItem Content="Erledigt / Häkchen"/>
                                <ComboBoxItem Content="Fähnchen"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Margin="0,0,10,0">

                            <TextBlock Text="Sortierung"
                                       FontSize="11"
                                       Foreground="#555555"
                                       Margin="1,0,0,3"/>

                            <ComboBox x:Name="SortComboBox"
                                      Height="31">
                                <ComboBoxItem Content="Neueste zuerst"/>
                                <ComboBoxItem Content="Älteste zuerst"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    VerticalAlignment="Bottom"
                                    Margin="3,0,10,6">

                            <CheckBox x:Name="SubjectOnlyCheckBox"
                                      Content="Nur Betreff"
                                      FontSize="13"/>
                        </StackPanel>

                        <Button x:Name="ResetFiltersButton"
                                Grid.Column="5"
                                Content="Filter zurücksetzen"
                                Height="31"
                                VerticalAlignment="Bottom"
                                Click="ResetFiltersButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- =================================================
                 AKTIVE FILTER
                 ================================================= -->
            <Border Grid.Row="8"
                    Background="#F8FAFC"
                    BorderBrush="#D7DCE1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="9,6">

                <TextBlock x:Name="ActiveFiltersText"
                           Text="Aktive Filter: keine"
                           FontSize="11"
                           Foreground="#666666"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Suchstatus -->
            <TextBlock x:Name="SearchStatusText"
                       Grid.Row="10"
                       Text=""
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       TextWrapping="Wrap"
                       Margin="2,0,0,6"/>

            <!-- =================================================
                 SUCHERGEBNISSE
                 ================================================= -->
            <DataGrid x:Name="SearchResultsGrid"
                      Grid.Row="11"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="#D7DCE1"
                      BorderThickness="1"
                      Background="White"
                      Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="SearchResultsGrid_MouseDoubleClick"
                      ToolTip="Doppelklick öffnet die Original-Mail in Outlook">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Datum"
                                        Binding="{Binding Date}"
                                        Width="135"/>

                    <DataGridTextColumn Header="Postfach"
                                        Binding="{Binding Mailbox}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Empfänger"
                                        Binding="{Binding Recipient}"
                                        Width="190"/>

                    <DataGridTextColumn Header="Absender"
                                        Binding="{Binding Sender}"
                                        Width="175"/>

                    <DataGridTextColumn Header="Kennzeichnung"
                                        Binding="{Binding Flag}"
                                        Width="145"/>

                    <DataGridTextColumn Header="Anhang"
                                        Binding="{Binding Attachment}"
                                        Width="85"/>

                    <DataGridTextColumn Header="Betreff"
                                        Binding="{Binding Subject}"
                                        Width="2.4*"/>

                    <DataGridTextColumn Header="Ordner"
                                        Binding="{Binding Folder}"
                                        Width="1.8*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- =====================================================
             FUSSZEILE
             ===================================================== -->
        <Border Grid.Row="2"
                Background="#E8ECF0">

            <Grid Margin="20,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Build 1080 | Datenfinder Gemeinde Reichenau PRO | © 2026"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           FontSize="11"/>

                <TextBlock Grid.Row="1"
                           Text="Entwickelt von Richard Tauchner in Zusammenarbeit mit OpenAI ChatGPT"
                           Foreground="#7A7A7A"
                           FontSize="9"
                           Margin="0,2,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>