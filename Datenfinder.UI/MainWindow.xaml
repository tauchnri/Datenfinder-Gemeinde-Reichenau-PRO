<Window x:Class="Datenfinder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datenfinder Gemeinde Reichenau PRO"
        Height="620"
        Width="1050"
        MinHeight="500"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#123B63">
            <Grid Margin="28,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Datenfinder Gemeinde Reichenau PRO"
                               Foreground="White"
                               FontSize="27"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Alles finden. Sofort."
                               Foreground="#D9E7F3"
                               FontSize="14"
                               Margin="1,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Height="46"
                         FontSize="17"
                         Padding="14,8"
                         VerticalContentAlignment="Center"
                         ToolTip="Suchbegriff eingeben"/>

                <Button Grid.Column="1"
                        Content="Suchen"
                        Height="46"
                        Margin="12,0,0,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        IsEnabled="False"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#D7DCE1"
                    BorderThickness="1"
                    Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Outlook 365"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="OutlookStatusText"
                                   Text="Status: noch nicht geprüft"
                                   FontSize="15"
                                   Foreground="#555555"
                                   Margin="0,8,0,0"/>

                        <TextBlock x:Name="OutlookDetailsText"
                                   Text=""
                                   FontSize="14"
                                   Foreground="#777777"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button x:Name="ConnectOutlookButton"
                            Grid.Column="1"
                            Content="Outlook prüfen"
                            Height="42"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Click="ConnectOutlookButton_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="4"
        Background="White"
        CornerRadius="8"
        BorderBrush="#D7DCE1"
        BorderThickness="1"
        Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Suchindex"
                       FontSize="20"
                       FontWeight="SemiBold"/>

                        <TextBlock x:Name="IndexStatusText"
                       Text="Noch nicht erstellt"
                       FontSize="15"
                       Foreground="#777777"
                       Margin="0,8,0,0"/>

                        <TextBlock x:Name="IndexDetailsText"
                       Text="Outlook ist bereit. Als Nächstes können die E-Mails erfasst werden."
                       FontSize="14"
                       Foreground="#777777"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
                    </StackPanel>

                    <Button x:Name="CreateIndexButton"
                Grid.Column="1"
                Content="Index erstellen"
                Height="42"
                VerticalAlignment="Center"
                FontSize="15"
                IsEnabled="False"
                Click="CreateIndexButton_Click"/>
                </Grid>
            </Border>

        </Grid>

        <Border Grid.Row="2" Background="#E8ECF0">
            <Grid Margin="20,0">
                <TextBlock Text="Build 1000 | Entwicklungsstand"
                       VerticalAlignment="Center"
                       Foreground="#555555"
                       FontSize="12"/>
            </Grid>
        </Border>

    </Grid>
</Window>