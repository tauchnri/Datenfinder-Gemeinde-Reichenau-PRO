<Window x:Class="Datenfinder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datenfinder Gemeinde Reichenau PRO"
        Height="860"
        Width="1350"
        MinHeight="720"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Border Grid.Row="0"
                Background="#123B63">
            <Grid Margin="28,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Datenfinder Gemeinde Reichenau PRO"
                               Foreground="White"
                               FontSize="27"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Alles finden. Sofort."
                               Foreground="#D9E7F3"
                               FontSize="14"
                               Margin="1,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hauptbereich -->
        <Grid Grid.Row="1"
              Margin="28,20,28,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Suchfeld -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Height="46"
                         FontSize="17"
                         Padding="14,8"
                         VerticalContentAlignment="Center"
                         ToolTip="Suchbegriff eingeben"
                         KeyDown="SearchTextBox_KeyDown"/>

                <Button x:Name="SearchButton"
                        Grid.Column="1"
                        Content="Suchen"
                        Height="46"
                        Margin="12,0,0,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        IsEnabled="False"
                        Click="SearchButton_Click"/>
            </Grid>

            <!-- Filter -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#D7DCE1"
                    BorderThickness="1"
                    Padding="14">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="175"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,10,0">
                        <TextBlock Text="Zeitraum von"
                                   FontSize="12"
                                   Foreground="#555555"
                                   Margin="1,0,0,4"/>

                        <DatePicker x:Name="FromDatePicker"
                                    Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,10,0">
                        <TextBlock Text="bis"
                                   FontSize="12"
                                   Foreground="#555555"
                                   Margin="1,0,0,4"/>

                        <DatePicker x:Name="ToDatePicker"
                                    Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,10,0">
                        <TextBlock Text="Postfach"
                                   FontSize="12"
                                   Foreground="#555555"
                                   Margin="1,0,0,4"/>

                        <ComboBox x:Name="MailboxComboBox"
                                  Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Margin="0,0,10,0">
                        <TextBlock Text="Anhang"
                                   FontSize="12"
                                   Foreground="#555555"
                                   Margin="1,0,0,4"/>

                        <ComboBox x:Name="AttachmentComboBox"
                                  Height="32">
                            <ComboBoxItem Content="Alle"/>
                            <ComboBoxItem Content="Mit Anhang"/>
                            <ComboBoxItem Content="Ohne Anhang"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Margin="0,0,10,0">
                        <TextBlock Text="Kennzeichnung"
                                   FontSize="12"
                                   Foreground="#555555"
                                   Margin="1,0,0,4"/>

                        <ComboBox x:Name="FlagComboBox"
                                  Height="32">
                            <ComboBoxItem Content="Alle"/>
                            <ComboBoxItem Content="Gekennzeichnet"/>
                            <ComboBoxItem Content="Nicht gekennzeichnet"/>
                            <ComboBoxItem Content="Erledigt / Häkchen"/>
                            <ComboBoxItem Content="Fähnchen"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="5"
                                Margin="0,0,10,0">
                        <TextBlock Text="Sortierung"
                                   FontSize="12"
                                   Foreground="#555555"
                                   Margin="1,0,0,4"/>

                        <ComboBox x:Name="SortComboBox"
                                  Height="32">
                            <ComboBoxItem Content="Neueste zuerst"/>
                            <ComboBoxItem Content="Älteste zuerst"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="6"
                                VerticalAlignment="Bottom"
                                Margin="3,0,15,6">
                        <CheckBox x:Name="SubjectOnlyCheckBox"
                                  Content="Nur Betreff"
                                  FontSize="13"/>
                    </StackPanel>

                    <Button x:Name="ResetFiltersButton"
                            Grid.Column="8"
                            Content="Filter zurücksetzen"
                            Height="32"
                            VerticalAlignment="Bottom"
                            Click="ResetFiltersButton_Click"/>
                </Grid>
            </Border>

            <!-- Outlook und Index -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Outlook -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="8"
                        BorderBrush="#D7DCE1"
                        BorderThickness="1"
                        Padding="18">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="165"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Outlook 365"
                                       FontSize="19"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="OutlookStatusText"
                                       Text="Status: noch nicht geprüft"
                                       FontSize="14"
                                       Foreground="#555555"
                                       TextWrapping="Wrap"
                                       Margin="0,7,12,0"/>

                            <TextBlock x:Name="OutlookDetailsText"
                                       Text=""
                                       FontSize="13"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       Margin="0,4,12,0"/>

                            <TextBlock x:Name="MailboxNamesText"
                                       Text=""
                                       FontSize="11"
                                       Foreground="#888888"
                                       TextWrapping="Wrap"
                                       Margin="0,5,12,0"/>
                        </StackPanel>

                        <Button x:Name="ConnectOutlookButton"
                                Grid.Column="1"
                                Content="Outlook prüfen"
                                Height="40"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Click="ConnectOutlookButton_Click"/>
                    </Grid>
                </Border>

                <!-- Suchindex -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="8"
                        BorderBrush="#D7DCE1"
                        BorderThickness="1"
                        Padding="18">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="165"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Suchindex"
                                       FontSize="19"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="IndexStatusText"
                                       Text="Suchindex noch nicht erstellt"
                                       FontSize="14"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       Margin="0,7,12,0"/>

                            <TextBlock x:Name="IndexDetailsText"
                                       Text="Klicken Sie zuerst auf „Outlook prüfen“."
                                       FontSize="13"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       Margin="0,4,12,0"/>

                            <TextBlock x:Name="LastUpdateText"
                                       Text=""
                                       FontSize="11"
                                       Foreground="#888888"
                                       TextWrapping="Wrap"
                                       Margin="0,5,12,0"/>

                            <TextBlock Text="Automatische Aktualisierung: alle 60 Minuten, solange der Datenfinder läuft."
                                       FontSize="11"
                                       Foreground="#888888"
                                       TextWrapping="Wrap"
                                       Margin="0,3,12,0"/>
                        </StackPanel>

                        <Button x:Name="CreateIndexButton"
                                Grid.Column="1"
                                Content="Jetzt aktualisieren"
                                Height="40"
                                VerticalAlignment="Center"
                                FontSize="14"
                                IsEnabled="False"
                                Click="CreateIndexButton_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Fortschritt -->
            <Border Grid.Row="6"
                    x:Name="ProgressPanel"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#D7DCE1"
                    BorderThickness="1"
                    Padding="12"
                    Visibility="Collapsed">

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ProgressPhaseText"
                                   Text="Vorbereitung ..."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="ProgressPercentText"
                                   Grid.Column="1"
                                   Text=""
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="15,0,0,0"/>
                    </Grid>

                    <ProgressBar x:Name="IndexProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="17"
                                 Margin="0,8,0,0"/>

                    <TextBlock x:Name="ProgressCountText"
                               Text=""
                               FontSize="12"
                               Foreground="#555555"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>

                    <TextBlock x:Name="ProgressFolderText"
                               Text=""
                               FontSize="12"
                               Foreground="#777777"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SearchStatusText"
                       Grid.Row="8"
                       Text=""
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       TextWrapping="Wrap"
                       Margin="2,0,0,7"/>

            <!-- Ergebnisse -->
            <DataGrid x:Name="SearchResultsGrid"
                      Grid.Row="9"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="#D7DCE1"
                      BorderThickness="1"
                      Background="White"
                      Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Datum"
                                        Binding="{Binding Date}"
                                        Width="135"/>

                    <DataGridTextColumn Header="Postfach"
                                        Binding="{Binding Mailbox}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Empfänger"
                                        Binding="{Binding Recipient}"
                                        Width="190"/>

                    <DataGridTextColumn Header="Absender"
                                        Binding="{Binding Sender}"
                                        Width="175"/>

                    <DataGridTextColumn Header="Kennzeichnung"
                                        Binding="{Binding Flag}"
                                        Width="145"/>

                    <DataGridTextColumn Header="Anhang"
                                        Binding="{Binding Attachment}"
                                        Width="85"/>

                    <DataGridTextColumn Header="Betreff"
                                        Binding="{Binding Subject}"
                                        Width="2.4*"/>

                    <DataGridTextColumn Header="Ordner"
                                        Binding="{Binding Folder}"
                                        Width="1.8*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Fuß -->
        <Border Grid.Row="2"
                Background="#E8ECF0">
            <Grid Margin="20,0">
                <TextBlock Text="Build 1060 | Intelligenter Outlook-Index"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>